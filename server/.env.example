# Copy to server/.env (git-ignored) and fill in. Only providers with a key are served.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Server
PORT=8787
# HOST=0.0.0.0

# Comma-separated browser origins allowed to call the proxy ("*" = any; not recommended).
ALLOWED_ORIGINS=https://aakash7192.github.io,http://localhost:5173,http://localhost:4173

# Requests per minute per client IP for POST /v1/chat (0 disables).
RATE_LIMIT_RPM=20
# Number of trusted reverse-proxy hops that append to X-Forwarded-For (0 = off; 1 for a single
# nginx/Render/Fly/Cloudflare hop). The client IP is taken from the right of the header, not the left.
# TRUST_PROXY=0

# Upper bound for the total upstream output budget per request (reply + thinking allowance).
MAX_TOKENS_CAP=4096

# 1 = ignore the client's system prompt and always use Sakha's persona (recommended).
PIN_SYSTEM_PROMPT=1

# Optional model allowlist: "model-id" or "provider:model-id", comma-separated. Empty = any.
ALLOWED_MODELS=

# Optional shared token the UI sends as x-sakhaon-token. It ships in a static bundle,
# so treat it as a speed bump, not a secret.
PROXY_TOKEN=

# Optional upstream overrides (e.g. a regional gateway).
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# GOOGLE_BASE_URL=
